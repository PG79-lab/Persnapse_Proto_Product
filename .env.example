# Public Supabase client configuration. Publishable keys are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only credentials. Never expose either value to client code.
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# AI task routing. `mock` keeps local development deterministic and makes no paid calls.
AI_ROUTING_MODE=mock

# Provider credentials. Add only the providers used by the enabled feature phase.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
OPENAI_API_KEY=
VOYAGE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Task-specific API targets from the accepted model-routing decision.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_STRUCTURING_MODEL=gpt-5.6-luna
VOYAGE_EMBEDDING_MODEL=voyage-4
OPENAI_EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
VOYAGE_RERANK_MODEL=rerank-3-lite
GOOGLE_MAIN_AGENT_MODEL=gemini-3.8-flash
ANTHROPIC_QUALITY_AGENT_MODEL=claude-sonnet-5
OPENAI_QUALITY_BENCHMARK_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_REASONING_MODEL=gpt-5.6-sol

# Application
APP_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
