{
  "name": "persnapse-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/copy-opencv.mjs && node scripts/copy-card-runtime.mjs && node scripts/copy-card-test.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-opencv.mjs && node scripts/copy-card-runtime.mjs && node scripts/copy-card-test.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "card:dataset": "node scripts/card_recognition/python.mjs scripts/card_recognition/generate_dataset.py",
    "card:validate-dataset": "node scripts/card_recognition/python.mjs scripts/card_recognition/validate_dataset.py",
    "card:benchmark": "node --import tsx scripts/card_recognition/benchmark.ts",
    "card:image-metrics": "node scripts/card_recognition/python.mjs scripts/card_recognition/image_metrics.py",
    "card:report": "node scripts/card_recognition/python.mjs scripts/card_recognition/report.py",
    "card:download-models": "node --import tsx scripts/card_recognition/download-models.ts",
    "card:inspect-models": "node scripts/card_recognition/python.mjs scripts/card_recognition/inspect_models.py",
    "card:compatibility": "node --import tsx scripts/card_recognition/compatibility.ts",
    "card:serve-test": "node --import tsx scripts/card_recognition/serve-test.ts",
    "card:test-ui": "npm run build && npm run card:serve-test",
    "card:test-e2e": "node scripts/card_recognition/run-e2e.mjs",
    "card:prepare-photos": "node scripts/card_recognition/python.mjs scripts/card_recognition/prepare_photos.py",
    "card:benchmark-photos": "node --import tsx scripts/card_recognition/benchmark-photos.ts",
    "card:report-photos": "node --import tsx scripts/card_recognition/report-photos.ts && node scripts/card_recognition/python.mjs scripts/card_recognition/overlay_photos.py",
    "card:serve-photo-report": "node --import tsx scripts/card_recognition/serve-photo-report.ts",
    "db:check": "node --env-file=.env.local scripts/db/check.mjs",
    "db:preflight": "node --env-file=.env.local scripts/db/preflight.mjs",
    "db:migrate:dry": "node --env-file=.env.local scripts/db/push.mjs --dry-run",
    "db:migrate": "node --env-file=.env.local scripts/db/push.mjs --yes",
    "db:setup": "node --env-file=.env.local scripts/db/push.mjs --include-seed --yes",
    "db:seed": "node --env-file=.env.local scripts/db/seed.mjs",
    "db:verify": "node --env-file=.env.local scripts/db/verify.mjs",
    "db:verify:phase4": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-phase4.ts",
    "db:verify:phase5": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-phase5.ts",
    "db:verify:phase5:live": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-phase5.ts --live-ocr --confirm-live",
    "db:verify:capture-storage": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-capture-storage.ts --confirm-test-writes",
    "db:verify:recall-storage": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-recall-storage.ts --confirm-test-writes",
    "db:verify:ocr-guard": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-ocr-cost-guard.ts",
    "db:report:ocr-usage": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/report-ocr-cost-usage.ts",
    "eval:recall": "node --env-file=.env.local --conditions=react-server --import tsx scripts/evals/recall.ts",
    "ai:verify:live": "node --env-file=.env.local --import tsx scripts/ai/verify-live.ts --confirm-live",
    "ai:verify:search-recovery": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-search-recovery.ts",
    "ai:verify:recall-readiness": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-recall-readiness.ts",
    "ai:verify:capture-recall-readiness": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-capture-recall-readiness.ts",
    "ai:verify:clova": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-clova-ocr.ts --confirm-live",
    "ai:verify:card-numbers": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-business-card-number-types.ts --confirm-live",
    "ai:compare:business-cards": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/compare-business-card-extractors.ts --confirm-live",
    "security:audit:secret-residue": "node --env-file=.env.local scripts/security/audit-secret-residue.mjs",
    "security:clean:local-secret-cache": "node scripts/security/clean-local-secret-cache.mjs",
    "deploy:protect:all": "node scripts/deploy/set-vercel-all-deployments-protection.mjs",
    "deploy:bootstrap": "node scripts/deploy/bootstrap-vercel-project.mjs",
    "deploy:verify:readiness": "node scripts/deploy/verify-vercel-preview-readiness.mjs",
    "deploy:env:preview": "node --env-file=.env.local scripts/deploy/sync-vercel-preview-env.mjs",
    "deploy:preview": "node scripts/deploy/deploy-vercel-preview.mjs",
    "deploy:verify:preview:live": "node --env-file=.env.local --conditions=react-server --import tsx scripts/deploy/verify-vercel-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run format:check && npm run build",
    "deploy:verify:preview:assistant": "node --env-file=.env.local --conditions=react-server --import tsx scripts/deploy/verify-live-memory-preview.mjs",
    "db:verify:workspace": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-workspace-integration.ts --confirm-test-writes",
    "test:workspace:browser": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/verify-workspace-browser.ts --confirm-test-writes",
    "ai:verify:workspace": "node --env-file=.env.local --conditions=react-server --import tsx scripts/ai/verify-workspace-live.ts --confirm-live",
    "deploy:verify:workspace": "node scripts/deploy/verify-workspace-preview.mjs",
    "card:export-photo-html": "node scripts/card_recognition/python.mjs scripts/card_recognition/export_photo_html.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "d3": "^7.9.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "onnxruntime-web": "1.30.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "30.0.1",
    "onnxruntime-node": "1.30.0",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
